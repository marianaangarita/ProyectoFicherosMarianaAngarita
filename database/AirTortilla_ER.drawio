        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;🔑 Clave primaria (PK)&lt;br&gt;🔗 Clave foránea (FK)&lt;br&gt;◆ Único (UNIQUE)&lt;br&gt;&lt;span style=&#39;color:#b85450&#39;&gt;&lt;b&gt;1 / N / M&lt;/b&gt;&lt;/span&gt; = cardinalidad&lt;br&gt;Azul: reservas · Naranja: seguridad · Morado: auditoría" vertex="1">
          <mxGeometry height="130" width="250" x="40" y="-60" as="geometry" />
        </mxCell>
